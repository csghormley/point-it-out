#!/bin/bash

# mapcfg - Unified management script for map configuration application
# This script consolidates all development, build, and deployment operations

set -euo pipefail

# Trap errors and report line number with better context
trap 'error_handler $? $LINENO "$BASH_COMMAND" "${BASH_LINENO[@]}" "${FUNCNAME[@]}"' ERR

error_handler() {
    local exit_code=$1
    local line_no=$2
    local bash_command=$3
    shift 3
    local bash_lineno=("$@")

    echo -e "\033[0;31mError: Command failed with exit code $exit_code\033[0m" >&2

    # Show the call stack
    if [ ${#bash_lineno[@]} -gt 1 ]; then
        echo -e "\033[0;31mCall stack:\033[0m" >&2
        local frame=0
        while [ $frame -lt ${#bash_lineno[@]} ]; do
            local lineno="${bash_lineno[$frame]}"
            local func="${FUNCNAME[$((frame + 1))]}"
            if [ "$func" != "error_handler" ] && [ "$func" != "main" ]; then
                echo -e "\033[0;31m  at $func() [line $lineno]\033[0m" >&2
            fi
            ((frame++)) || true
        done
    else
        echo -e "\033[0;31m  at line $line_no\033[0m" >&2
    fi
}

# Determine working directory
WORKDIR="$(cd "$(dirname "$0")" && pwd)"

# Colors for output (needed for error messages)
RED='\033[0;31m'
NC='\033[0m' # No Color

# Load configuration from .mapcfgrc - required
if [ -f "$WORKDIR/.mapcfgrc" ]; then
    # shellcheck disable=SC1091
    . "$WORKDIR/.mapcfgrc"
else
    echo -e "${RED}ERROR: Configuration file .mapcfgrc not found${NC}" >&2
    echo "" >&2
    echo "Create .mapcfgrc from the example template:" >&2
    echo "  cp .mapcfgrc.example .mapcfgrc" >&2
    echo "" >&2
    echo "Then edit .mapcfgrc to customize settings for your environment." >&2
    exit 1
fi

# Set defaults for any unset configuration variables
: "${DB_CONTAINER:=postgis}"
: "${DB_NAME:=mapbe}"
: "${SSH_SERVER:=}"
: "${SSH_PORT:=22}"
: "${SSH_KEY_PATH:=$HOME/.ssh/id_rsa_backup}"
: "${BACKUP_DIR:=postgis_data/pgdata}"
: "${SYSTEMD_SERVICE:=docker.mapsurvey.service}"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Helper functions
error() {
    echo -e "${RED}ERROR: $1${NC}" >&2
    exit 1
}

success() {
    echo -e "${GREEN}✓ $1${NC}"
}

info() {
    echo -e "${YELLOW}→ $1${NC}"
}

# Conditional sudo - only use sudo if not already root
maybe_sudo() {
    if [ "$(id -u)" -eq 0 ]; then
        "$@"
    else
        sudo "$@"
    fi
}

# Ensure we're in the project root
ensure_root() {
    if [ ! "$WORKDIR" = "$PWD" ]; then
        error "This script must be run from the project root directory"
    fi
    cd "$WORKDIR"
}

# Activate virtual environment
activate_venv() {
    if [ -f "$WORKDIR/.venv/bin/activate" ]; then
        # shellcheck disable=SC1091
        . "$WORKDIR/.venv/bin/activate"
    else
        error "Virtual environment not found. Run './mapcfg bootstrap' first."
    fi
}

###################
# VERB FUNCTIONS
###################

# bootstrap - Initial environment setup
cmd_bootstrap() {
    info "Starting bootstrap process..."

    if ! command -v python3 &> /dev/null; then
        info "Installing Python 3..."
        maybe_sudo apt-get update
        maybe_sudo apt-get install -y python3 python-is-python3
    fi

    # Check if uv is installed
    if ! command -v uv &> /dev/null; then
        info "Installing uv..."
        curl -LsSf https://astral.sh/uv/install.sh | sh
        # Add uv to PATH for current session
        export PATH="$HOME/.local/bin:$PATH"
    fi

    if [ ! -d "$WORKDIR/.venv" ]; then
        info "Creating virtual environment with uv..."
        uv venv "$WORKDIR/.venv"
    else
        info "Virtual environment already exists"
    fi

    info "Installing Python dependencies with uv..."
    uv sync

    success "Bootstrap complete!"
}

# check - Run validation checks
cmd_check() {
    info "Running validation checks..."
    activate_venv

    # Verify venv path matches current directory
    if [ -f "$WORKDIR/.venv/bin/activate" ]; then
        venv_path=$(grep "^VIRTUAL_ENV=" "$WORKDIR/.venv/bin/activate" | cut -d"'" -f2)
        expected_path="$WORKDIR/.venv"
        if [ "$venv_path" != "$expected_path" ]; then
            error "Virtual environment path mismatch!"
            error "Expected: $expected_path"
            error "Found:    $venv_path"
            error "Run './mapcfg bootstrap' to recreate the virtual environment"
        fi
    fi

    # Django check
    if ./collector/manage.py check; then
        success "Django check passed"
    else
        error "Django check failed"
    fi

    # Template validation
    if ./collector/manage.py validate_templates; then
        success "Template validation passed"
    else
        error "Template validation failed"
    fi

    # Ruff linting
    error_lines=$(ruff check collector/ | grep "= help" | grep -v "Remove unused" | wc -l || true)
    if [ "$error_lines" -gt 0 ]; then
        error "Ruff found $error_lines errors"
    else
        success "Ruff check passed"
    fi

    # Docker Compose configuration validation
    if command -v docker &> /dev/null && docker compose version &> /dev/null; then
        if docker compose -f docker-stack/docker-compose.yml config > /dev/null 2>&1; then
            success "Docker Compose config validation passed"
        else
            error "Docker Compose config validation failed"
        fi
    else
        info "Docker Compose not available, skipping config validation"
    fi

    success "All checks passed!"
}

# version - Update version.txt from git
cmd_version() {
    git log --pretty=format:"%h %ad | %s [%an]" --date=short -1
}

# build - Build Docker images
cmd_build() {
    info "Building Docker images..."
    activate_venv

    # Run checks first
    cmd_check

    # Collect static files
    info "Collecting static files..."
    ./collector/manage.py collectstatic --noinput

    # Update version
    info "Generating version.txt..."
    cmd_version > "$WORKDIR/collector/pio/templates/pio/version.txt"
    success "Version file updated"


    # Build Docker images in order
    info "Building Docker images..."
    ./docker-stack/build-deps.sh
    ./docker-stack/build-django-env.sh
    ./docker-stack/build-django.sh
    ./docker-stack/build-nginx.sh

    success "Docker images built successfully!"
}

# maintenance - Clean up Docker resources
cmd_maintenance() {
    info "Running Docker system maintenance..."
    maybe_sudo docker system prune --filter "until=24h" --all --force
    success "Maintenance complete"
}

# check_services_running - Silent check if all required services are running
check_services_running() {
    # Returns 0 if all services running, 1 if any missing
    docker ps --format "{{.Names}}" | grep -q "nginx" && \
    docker ps --format "{{.Names}}" | grep -q "postgis" && \
    docker ps --format "{{.Names}}" | grep -q "django"
}

# wait_for_services - Wait for all services to be running
wait_for_services() {
    local timeout=10
    local count=0

    info "Waiting for services to start..."

    while [ $count -lt $timeout ]; do
        if check_services_running; then
            success "All services are running"
            return 0
        fi
        sleep 1
        count=$((count + 1))
    done

    # Timeout - show which services are missing
    error "Services failed to start within ${timeout} seconds:"
    echo ""
    if ! docker ps --format "{{.Names}}" | grep -q "nginx"; then
        echo -e "${RED}  ✗ nginx is not running${NC}"
    fi
    if ! docker ps --format "{{.Names}}" | grep -q "postgis"; then
        echo -e "${RED}  ✗ postgis is not running${NC}"
    fi
    if ! docker ps --format "{{.Names}}" | grep -q "django"; then
        echo -e "${RED}  ✗ django is not running${NC}"
    fi
    echo ""
    return 1
}

# status - Check system status
cmd_status() {
    info "Checking system status..."

    echo ""
    echo "Docker Container Status:"

    if docker ps --format "{{.Names}}" | grep -q "nginx"; then
        success "nginx is running"
    else
        echo -e "${RED}✗ nginx is not running${NC}"
    fi

    if docker ps --format "{{.Names}}" | grep -q "postgis"; then
        success "postgis is running"
    else
        echo -e "${RED}✗ postgis is not running${NC}"
    fi

    if docker ps --format "{{.Names}}" | grep -q "django"; then
        success "django is running"
    else
        echo -e "${RED}✗ django is not running${NC}"
    fi

    running_count=$(docker ps | grep -v "^CONTAINER" | wc -l)
    echo ""
    info "$running_count Docker containers running"

    echo ""
    echo "Storage Status:"
    df -h . | tail -1
}

# backup - Backup database
cmd_backup() {
    local server_arg="${1:-${SSH_SERVER:-}}"
    local port="${2:-${SSH_PORT:-22}}"

    info "Backing up database..."

    # Parse user@server format
    local ssh_user=""
    local server=""
    if [ -n "$server_arg" ]; then
        if [[ "$server_arg" =~ @ ]]; then
            ssh_user="${server_arg%%@*}"
            server="${server_arg#*@}"
        else
            error "SSH_SERVER must be in user@hostname format (e.g., backups@server.com)"
        fi
    fi

    # Generate timestamps and backup filename
    local TS=$(date +%s)
    local DATESTAMP=$(date +%Y%m%d-%H%M%S)
    local BACKUP_FILE="$DB_NAME-backup-$DATESTAMP.sql.gz"
    local TEMP_SCRIPT="tmp-backup-${TS}-$$.sh"

    info "Container: $DB_CONTAINER"
    info "Database: $DB_NAME"
    info "Backup file: $BACKUP_FILE"

    # Cleanup function to remove temp files on exit
    cleanup_backup() {
        if [ -n "${TEMP_SCRIPT:-}" ] && [ -f "$TEMP_SCRIPT" ]; then
            rm -f "$TEMP_SCRIPT"
        fi
    }
    trap cleanup_backup EXIT

    # Define a function to pull the first matching container ID
    get_container_id() {
        if [ -n "$1" ]; then
            local matches=$(docker ps --format "{{.Names}} {{.ID}}" | grep "$1" | wc -l)
            if [ "$matches" -eq 1 ]; then
                docker ps --format "{{.Names}} {{.ID}}" | grep "$1" | awk '{print $2}'
            elif [ "$matches" -gt 1 ]; then
                error "Multiple containers match '$1'"
            else
                echo ""
            fi
        fi
    }

    # Wait for container to be running
    wait_for_container() {
        local name="$1"
        local timeout=30
        local count=0

        info "Waiting for container '$name' to be running..."
        while [ $count -lt $timeout ]; do
            if docker ps | grep -q "$name"; then
                success "Container '$name' is running"
                return 0
            fi
            sleep 1
            count=$((count + 1))
        done

        error "Timeout waiting for container '$name'"
    }

    # Wait for db in a container to be online
    wait_for_db() {
        local container="$1"
        local db="$2"
        local timeout=30
        local count=0

        local container_id=$(get_container_id "$container")

        if [ -z "$container_id" ]; then
            error "Could not find container ID for '$container'"
        fi

        info "Waiting for database '$db' to be ready..."
        while [ $count -lt $timeout ]; do
            if docker exec -i -u root "$container_id" runuser -u postgres -- psql -l 2>/dev/null | grep -q "$db"; then
                success "Database '$db' is ready"
                return 0
            fi
            echo "Waiting... ($count/$timeout)"
            sleep 1
            count=$((count + 1))
        done

        error "Timeout waiting for database '$db' in container '$container'"
    }

    # Create a temporary script to execute the backup
    cat <<EOF > "$TEMP_SCRIPT"
#!/bin/bash
set -euo pipefail

# Perform database dump
runuser -u postgres -- pg_dumpall | gzip -c > /tmp/$BACKUP_FILE

# Verify backup was created and has content
if [ ! -f /tmp/$BACKUP_FILE ]; then
    echo "ERROR: Backup file was not created" >&2
    exit 1
fi

if [ ! -s /tmp/$BACKUP_FILE ]; then
    echo "ERROR: Backup file is empty" >&2
    exit 1
fi

# Move backup to persistent storage
mv /tmp/$BACKUP_FILE /var/lib/postgresql/data/pgdata/

echo "Backup completed: $BACKUP_FILE"
EOF

    # Make sure the container is running before we try to access it
    info "Checking container status..."
    local DB_CONTAINER_ID=$(get_container_id "$DB_CONTAINER")

    if [ -z "$DB_CONTAINER_ID" ]; then
        error "Container '$DB_CONTAINER' not found"
    fi

    info "Found container ID: $DB_CONTAINER_ID"

    wait_for_container "$DB_CONTAINER"
    wait_for_db "$DB_CONTAINER" "$DB_NAME"

    # Create backup directory if it doesn't exist
    mkdir -p "$BACKUP_DIR"

    # Run the backup script in the container
    info "Executing backup in container..."
    if docker exec -i -u root "$DB_CONTAINER_ID" bash < "$TEMP_SCRIPT"; then
        success "Backup created successfully"
    else
        error "Backup failed"
    fi

    # Verify local backup file exists
    if [ ! -f "$BACKUP_DIR/$BACKUP_FILE" ]; then
        error "Backup file not found at $BACKUP_DIR/$BACKUP_FILE"
    fi

    # Get backup file size for reporting
    local BACKUP_SIZE=$(du -h "$BACKUP_DIR/$BACKUP_FILE" | cut -f1)
    info "Backup size: $BACKUP_SIZE"

    # Create symlink to the latest backup
    info "Creating symlink to latest backup..."
    ln -sf "$BACKUP_FILE" "$BACKUP_DIR/$DB_NAME-backup-latest.sql.gz"

    # Ship database backup to remote server if configured
    if [ -n "$server" ]; then
        info "Shipping database backup to $ssh_user@$server..."

        # Determine base path (try to find the actual full path)
        local FULL_BACKUP_PATH="$(cd "$(dirname "$BACKUP_DIR")" && pwd)/$(basename "$BACKUP_DIR")"
        local HOSTNAME=$(hostname)

        # Expand tilde in SSH_KEY_PATH
        local SSH_KEY_PATH_EXPANDED="${SSH_KEY_PATH/#\~/$HOME}"

        # Build rsync command with SSH options
        local RSYNC_CMD="rsync -avz"

        if [ -f "$SSH_KEY_PATH_EXPANDED" ]; then
            RSYNC_CMD="$RSYNC_CMD -e \"ssh -p$port -i $SSH_KEY_PATH_EXPANDED\""
        else
            RSYNC_CMD="$RSYNC_CMD -e \"ssh -p$port\""
            echo -e "${YELLOW}WARNING: SSH key not found at $SSH_KEY_PATH_EXPANDED, attempting passwordless SSH${NC}" >&2
        fi

        # Use eval to properly handle the quoted ssh command
        if eval "$RSYNC_CMD \"$FULL_BACKUP_PATH/$BACKUP_FILE\" \"$ssh_user@$server:db_backups/$HOSTNAME/\""; then
            success "Remote backup successful"
        else
            echo -e "${YELLOW}WARNING: Remote backup failed, but local backup is available${NC}" >&2
        fi
    else
        info "No remote server configured, skipping remote backup"
    fi

    success "Backup complete!"
    info "Local backup: $BACKUP_DIR/$BACKUP_FILE"
    [ -n "$server" ] && info "Remote backup: $ssh_user@$server:db_backups/$(hostname)/$BACKUP_FILE"
}

# run - Build and deploy
cmd_run() {
    local do_backup=false

    # Check for backup flag
    if [ "${1:-}" = "backup" ]; then
        do_backup=true
    fi

    info "Starting build and deploy process..."

    # Build
    maybe_sudo ./mapcfg build

    # Restart service
    info "Restarting Docker service..."
    maybe_sudo systemctl restart "$SYSTEMD_SERVICE"

    # Wait for all services to be running
    if ! wait_for_services; then
        exit 1
    fi

    # Backup if requested
    if [ "$do_backup" = true ]; then
        cmd_backup
    fi

    # Maintenance
    maybe_sudo ./mapcfg maintenance

    # Status
    cmd_status

    # Check if docs are out of date
    if [ -d "docs/source" ]; then
        # Check if any .rst files are newer than the build directory
        if [ -d "docs/build/html" ]; then
            local newest_rst=$(find docs/source -name "*.rst" -newer docs/build/html 2>/dev/null | head -1)
            if [ -n "$newest_rst" ]; then
                echo ""
                echo -e "${YELLOW}NOTE: Documentation may be out of date.${NC}"
                echo -e "${YELLOW}      Rebuild with: cd docs && make html${NC}"
            fi
        else
            echo ""
            echo -e "${YELLOW}NOTE: Documentation has not been built.${NC}"
            echo -e "${YELLOW}      Build with: cd docs && make html${NC}"
        fi
    fi

    success "Deploy complete!"
}

# migrate - Complete migration workflow
cmd_migrate() {
    info "Starting migration workflow..."
    activate_venv

    # Run checks
    if ./collector/manage.py check; then
        success "Django check passed"
    else
        error "Django check failed - aborting migration"
    fi

    # Create migrations
    info "Creating migrations..."
    if ./collector/manage.py makemigrations; then
        success "Migrations created"
    else
        error "Migration creation failed"
    fi

    # Build and deploy
    ./mapcfg run

    # Apply migrations
    info "Applying migrations to database..."
    docker compose -f docker-stack/docker-compose.yml exec -i django ./manage.py migrate

    success "Migration complete!"
}

# help - Show usage information
cmd_help() {
    local specific_cmd="${1:-}"

    # Command-specific help
    case "$specific_cmd" in
        bootstrap)
            cat <<EOF
bootstrap - Initial environment setup

  Sets up the development environment by installing Python 3, creating a virtual
  environment, and installing all Python dependencies from requirements.txt.
  This should be the first command run on a new system.
EOF
            ;;
        check)
            cat <<EOF
check - Run validation checks

  Runs Django system checks, template validation, Ruff linting, and Docker
  Compose configuration validation to verify code quality and configuration.
  All checks must pass before building. Useful to run before commits to
  catch issues early.
EOF
            ;;
        build)
            cat <<EOF
build - Build Docker images

  Runs all validation checks, collects static files, updates version.txt, then
  builds all Docker images (deps, django-env, django, nginx) in the correct order.
  This prepares the application for deployment.
EOF
            ;;
        run)
            cat <<EOF
run [backup] - Build and deploy application

  Builds Docker images, restarts the systemd service, and performs maintenance.
  Add 'backup' argument to also backup the database after deployment.
  Use this for regular deployments after code changes.
EOF
            ;;
        migrate)
            cat <<EOF
migrate - Complete migration workflow

  Runs Django checks, creates migrations with makemigrations, builds and deploys
  the application, then applies migrations to the database.
  Use this workflow after making changes to Django models.
EOF
            ;;
        backup)
            cat <<EOF
backup [user@server] [port] - Backup database

  Creates a compressed SQL dump of all databases, verifies integrity, and creates
  a symlink to the latest backup. Optionally uploads to remote server via rsync.
  Server must be in user@hostname format (e.g., backups@server.com).
EOF
            ;;
        status)
            cat <<EOF
status - Check system and container status

  Displays the running state of Docker containers (nginx, postgis, mapsurvey-app),
  shows total running container count, and displays current disk usage.
  Quick health check for the deployed system.
EOF
            ;;
        maintenance)
            cat <<EOF
maintenance - Clean up Docker resources

  Runs 'docker system prune --force' with a filter to remove unused containers, networks,
  images, and build cache. Frees up disk space after builds and deployments.
  Automatically run during the build process.
EOF
            ;;
        version)
            cat <<EOF
version - Update version.txt from git log

  Generates version.txt from the latest git commit, showing commit hash, date,
  message, and author. This file is displayed in the application footer.
  Automatically run during the build process.
EOF
            ;;
        help)
            cat <<EOF
help [command] - Show help information

  Without arguments, displays general usage and all available commands.
  With a command name, shows detailed help for that specific command.
  Example: ./mapcfg help backup
EOF
            ;;
        "")
            # General help
            cat <<EOF
mapcfg - Unified management script for map configuration application

Usage: ./mapcfg <command> [arguments]
       ./mapcfg help [command]  # Show help for specific command

Commands:
    bootstrap              Initial environment setup (install dependencies, create venv)
    check                  Run validation checks (Django, templates, linting)
    build                  Build Docker images (includes checks and static collection)
    run [backup]              Build and deploy application (add 'backup' to backup DB)
    migrate                   Complete migration workflow (makemigrations, build, deploy, migrate)
    backup [user@server] [port] Backup database (optionally to remote server)
    status                    Check system and container status
    maintenance            Clean up Docker resources
    version                Update version.txt from git log
    help [command]         Show this help message or help for specific command

Examples:
    ./mapcfg bootstrap                  # First-time setup
    ./mapcfg check                      # Validate code before committing
    ./mapcfg run                        # Build and deploy
    ./mapcfg run backup                 # Build, deploy, and backup database
    ./mapcfg migrate                    # Run after model changes
    ./mapcfg backup                     # Backup database locally
    ./mapcfg backup user@server.com     # Backup and upload to remote server as 'user'
    ./mapcfg backup user@server.com 22  # Backup and upload to remote server on port 22
    ./mapcfg status                     # Check system health
    ./mapcfg help backup                # Show detailed help for backup command

Configuration:
    Settings can be customized in .mapcfgrc

    Current settings:
      Database container: $DB_CONTAINER
      Database name: $DB_NAME
      Systemd service: $SYSTEMD_SERVICE

Configuration File (.mapcfgrc):
    DB_CONTAINER          PostgreSQL container name (default: postgis)
    DB_NAME               Database name (default: mapbe)
    SSH_SERVER            Remote backup server in user@hostname format (e.g., backups@server.com)
    SSH_PORT              SSH port for remote backup (default: 22)
    SSH_KEY_PATH          Path to SSH key (default: ~/.ssh/id_rsa_backup)
    BACKUP_DIR            Local directory for backups (default: postgis_data/pgdata)
    SYSTEMD_SERVICE       Systemd service name (default: docker.mapsurvey.service)

Note: Environment variables override .mapcfgrc settings
EOF
            ;;
        *)
            error "Unknown command: $specific_cmd\n\nRun './mapcfg help' to see available commands."
            ;;
    esac
}

###################
# MAIN
###################

ensure_root

# ensure locally installed commands are available
export PATH=$PATH:$HOME/.local/bin

# Get command
COMMAND="${1:-help}"
shift || true

# Execute command
case "$COMMAND" in
    bootstrap)
        cmd_bootstrap "$@"
        ;;
    check)
        cmd_check "$@"
        ;;
    build)
        cmd_build "$@"
        ;;
    run)
        cmd_run "$@"
        ;;
    migrate)
        cmd_migrate "$@"
        ;;
    backup)
        cmd_backup "$@"
        ;;
    status)
        cmd_status "$@"
        ;;
    maintenance)
        cmd_maintenance "$@"
        ;;
    version)
        cmd_version "$@"
        ;;
    help|--help|-h)
        cmd_help "$@"
        ;;
    *)
        error "Unknown command: $COMMAND\n\nRun './mapcfg help' for usage information."
        ;;
esac
