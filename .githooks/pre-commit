#!/bin/bash
#
# Pre-commit hook to run mapcfg check before allowing commits
# This ensures code quality and configuration validity before committing
#

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${YELLOW}Running pre-commit checks...${NC}"
echo ""

# Get the repository root directory
REPO_ROOT=$(git rev-parse --show-toplevel)

# Change to repository root
cd "$REPO_ROOT"

# Run mapcfg check
if ./mapcfg check; then
    echo ""
    echo -e "${GREEN}✓ All pre-commit checks passed!${NC}"
    echo ""
    exit 0
else
    echo ""
    echo -e "${RED}✗ Pre-commit checks failed!${NC}"
    echo ""
    echo -e "${YELLOW}Fix the issues above before committing.${NC}"
    echo ""
    echo "To bypass this hook (not recommended), use:"
    echo "  git commit --no-verify"
    echo ""
    exit 1
fi
